<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ankang.contract.mapper.InstitutionNoGenerator">
    
    <select id="getNextInstitutionNo" resultType="java.lang.String">
        SELECT COALESCE(MAX(institution_no), '100000') FROM institution FOR UPDATE
    </select>
    
</mapper>
