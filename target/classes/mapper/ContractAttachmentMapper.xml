<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ankang.contract.mapper.ContractAttachmentMapper">

    <resultMap id="BaseResultMap" type="com.ankang.contract.entity.ContractAttachment">
        <id column="id" property="id"/>
        <result column="contract_no" property="contractNo"/>
        <result column="original_name" property="originalName"/>
        <result column="stored_name" property="storedName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="upload_by" property="uploadBy"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM contract_attachment WHERE id = #{id}
    </select>

    <select id="findByContractNo" resultMap="BaseResultMap">
        SELECT * FROM contract_attachment WHERE contract_no = #{contractNo} ORDER BY create_time DESC
    </select>

    <select id="countByContractNo" resultType="java.lang.Long">
        SELECT COUNT(*) FROM contract_attachment WHERE contract_no = #{contractNo}
    </select>

    <insert id="insert" parameterType="com.ankang.contract.entity.ContractAttachment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO contract_attachment (contract_no, original_name, stored_name, file_path, file_size, file_type, upload_by, remark)
        VALUES (#{contractNo}, #{originalName}, #{storedName}, #{filePath}, #{fileSize}, #{fileType}, #{uploadBy}, #{remark})
    </insert>

    <delete id="deleteById">
        DELETE FROM contract_attachment WHERE id = #{id}
    </delete>

    <delete id="deleteByContractNo">
        DELETE FROM contract_attachment WHERE contract_no = #{contractNo}
    </delete>

</mapper>
